    {
      "parameters": {
        "jsCode": "// 1. Ambil data komentar asli dari node sebelum Groq\nconst originalData = $('Filter Komentar Baru').all();\n\n// 2. Proses hasil dari AI satu per satu\nreturn $input.all().map((item, index) => {\n  \n  // Mengambil jawaban AI (di n8n biasanya hasil AI diletakkan di field 'text')\n  const raw = item.json.text || item.json.message?.content || item.json.output || '';\n  \n  let parsed = {};\n  try {\n    // Mengekstrak hanya bagian JSON dari jawaban AI\n    const match = String(raw).match(/\\{[\\s\\S]*?\\}/);\n    if (match) parsed = JSON.parse(match[0]);\n  } catch(e) {\n    parsed = { sentimen: 'netral', skor_marah: 0, topik_utama: 'error', ringkasan: 'Gagal parse', perlu_respons: false };\n  }\n\n  // 3. Mengambil kembali data asli berdasarkan nomor urutannya\n  const src = originalData[index] ? originalData[index].json : {};\n\n  // 4. Gabungkan Data Asli dan Hasil AI\n  return {\n    json: {\n      // --- Data Asli YouTube ---\n      comment_id:    src.comment_id    || '',\n      author:        src.author        || '',\n      text:          src.text          || '', // Sekarang ini akan kembali berisi isi komentar YouTube\n      published_at:  src.published_at  || '',\n      like_count:    src.like_count    || 0,\n      video_id:      src.video_id      || '',\n      ingested_at:   src.ingested_at   || '',\n      \n      // --- Hasil Analisis AI ---\n      sentimen:      parsed.sentimen   || 'netral',\n      skor_marah:    Number(parsed.skor_marah) || 0,\n      topik_utama:   parsed.topik_utama|| '',\n      ringkasan:     parsed.ringkasan  || '',\n      perlu_respons: parsed.perlu_respons ?? false,\n      draf_balasan:  parsed.draf_balasan || '',\n      analyzed_at:   new Date().toISOString()\n    }\n  };\n});"
      },
