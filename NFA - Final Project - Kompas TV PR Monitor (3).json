    {
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const d = item.json;\n\n  const bar = (s) => '🔴'.repeat(Math.min(Math.round(s), 10)) + '⚪'.repeat(Math.max(10 - Math.round(s), 0));\n  const level = d.skor_marah >= 10 ? '🚨 **KRISIS TOTAL**'\n              : d.skor_marah >= 9  ? '🔴 **BAHAYA TINGGI**'\n              :                      '⚠️ **PERINGATAN**';\n\n  const tgl = new Date(d.analyzed_at || Date.now()).toLocaleString('id-ID', {\n    timeZone: 'Asia/Jakarta', day: '2-digit', month: 'short',\n    year: 'numeric', hour: '2-digit', minute: '2-digit'\n  });\n\n  const url     = `https://www.youtube.com/watch?v=${d.video_id}&lc=${d.comment_id}`;\n  const preview = (d.text || '').length > 280 ? d.text.substring(0, 280) + '...' : (d.text || '');\n\n  const teksBalasan = d.draf_balasan\n    ? [`💡 **Draf Balasan AI:**`, `> ${d.draf_balasan}`, '']\n    : [];\n\n  const pesan = [\n    level, '',\n    `📊 **Skor Marah: ${d.skor_marah}/10**`,\n    bar(d.skor_marah), '',\n    `👤 **Author:** ${d.author || 'Anonim'}`,\n    `🏷️ **Topik:** ${d.topik_utama || '-'}`,\n    `💬 **Sentimen:** ${(d.sentimen || '').toUpperCase()}`, '',\n    `📝 **Ringkasan:**`,\n    `> ${d.ringkasan || '-'}`, '',\n    `💬 **Komentar Asli:**`,\n    `\\`\\`\\`\\n${preview}\\n\\`\\`\\``,\n    ...teksBalasan,\n    `🔗 [Klik Untuk Lihat Komentar](${url})`, '',\n    `🕐 ${tgl} WIB`,\n    `#PRKompasTV #KrisisKomentar`\n  ].join('\\n');\n\n  return { json: { ...d, pesan } };\n});"
      },
