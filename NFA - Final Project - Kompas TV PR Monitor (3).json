    {
      "parameters": {
        "jsCode": "const newComments = $input.all();\n\nlet existingRows = [];\ntry {\n  existingRows = $('Cek Database (Sheets)').all();\n} catch (e) {\n  existingRows = [];\n}\n\n// Gunakan Set untuk lookup lebih cepat\nconst existingIds = new Set(\n  existingRows\n    .map(row => String(row.json.comment_id || '').trim())\n    .filter(id => id)\n);\n\n// Filter ketat: buang komentar yang comment_id-nya sudah ada\nconst filtered = newComments.filter(comment => {\n  const id = String(comment.json.comment_id || '').trim();\n  return id && !existingIds.has(id);\n});\n\n// Jika tidak ada komentar baru sama sekali, hentikan workflow\nif (filtered.length === 0) {\n  return [];\n}\n\nreturn filtered;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
