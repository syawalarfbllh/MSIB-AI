    {
      "parameters": {
        "jsCode": "const newItems = [];\nconst chunkSize = 1000;\nconst overlap = 100;\n\nfor (let item of $input.all()) {\n  // 1. JURUS SAPU BERSIH: Ubah seluruh data jadi teks untuk mendeteksi error di metadata\n  let itemString = JSON.stringify(item);\n  \n  // Hapus semua variasi Null Byte dari seluruh bagian file (teks dan metadata)\n  itemString = itemString.replace(/\\\\u0000/g, ''); \n  itemString = itemString.replace(/\\u0000/g, '');\n  \n  // Kembalikan menjadi format objek data n8n\n  let cleanItem = JSON.parse(itemString);\n\n  // 2. Lakukan pemotongan teks (Chunking) pada data yang sudah 100% bersih\n  if (cleanItem.json && cleanItem.json.text) {\n    let text = cleanItem.json.text;\n    let i = 0;\n    \n    // Jika teks ternyata pendek, tidak perlu dipotong\n    if (text.length <= chunkSize) {\n       newItems.push(cleanItem);\n       continue;\n    }\n\n    while (i < text.length) {\n      let chunk = text.substring(i, i + chunkSize);\n      \n      newItems.push({\n        json: {\n          ...cleanItem.json,\n          text: chunk\n        }\n      });\n      \n      i += (chunkSize - overlap);\n    }\n  } else {\n    // Jika bukan teks, lewatkan saja\n    newItems.push(cleanItem);\n  }\n}\n\nreturn newItems;"
      },
